bazel_dep(name = "rules_dotnet")
git_override(
    module_name = "rules_dotnet",
    remote = "https://github.com/agocke/rules_dotnet.git",
    branch = "runtime",
)

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "10.0.100")
use_repo(dotnet, "dotnet_toolchains")

register_toolchains("@dotnet_toolchains//:all")

main_extension = use_extension("//paket:paket.main_extension.bzl", "main_extension")

use_repo(
    main_extension,
    "paket.main",
    "nuget.microsoft.dotnet.arcade.sdk.v10.0.0-beta.26102.102",
    "nuget.microsoft.dotnet.genfacades.v10.0.0-beta.26102.102",
    "nuget.microsoft.dotnet.xunitconsolerunner.v2.9.3-beta.26102.102",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.14")

# ICU4C headers for System.Globalization.Native (macOS: homebrew, Linux: system)
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
new_local_repository(
    name = "icu4c",
    path = "/opt/homebrew/opt/icu4c",
    build_file = "//eng/bazel:icu4c.BUILD",
)
