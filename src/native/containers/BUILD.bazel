load("@rules_cc//cc:defs.bzl", "cc_library")

# dn-containers for linux-x64
# Utility container library (allocator, list, queue, vector, umap, simdhash)
# Used by eventpipe and other native code.

_SOURCES = [
    "dn-allocator.c",
    "dn-fwd-list.c",
    "dn-list.c",
    "dn-queue.c",
    "dn-umap.c",
    "dn-vector.c",
    "dn-simdhash.c",
    "dn-simdhash-string-ptr.c",
    "dn-simdhash-u32-ptr.c",
    "dn-simdhash-ptr-ptr.c",
    "dn-simdhash-ght-compatible.c",
    "dn-simdhash-ptrpair-ptr.c",
    "dn-simdhash-utils.c",
]

_HEADERS = glob(["*.h"]) + [
    "dn-sort-frag.inc",
]

cc_library(
    name = "dn-containers",
    srcs = _SOURCES + [
        "bazel/linux-glibc-x64/dn-config.h",
    ] + _HEADERS,
    copts = [
        "-Isrc/native",
        "-Isrc/native/containers/bazel/linux-glibc-x64",
    ],
    includes = ["."],
    visibility = ["//src/native:__subpackages__"],
    deps = [
        "//src/native/minipal",
    ],
)

cc_library(
    name = "dn-containers-no-lto",
    srcs = _SOURCES + [
        "bazel/linux-glibc-x64/dn-config.h",
    ] + _HEADERS,
    copts = [
        "-Isrc/native",
        "-Isrc/native/containers/bazel/linux-glibc-x64",
        "-fno-lto",
    ],
    includes = ["."],
    visibility = ["//src/native:__subpackages__"],
    deps = [
        "//src/native/minipal",
    ],
)
