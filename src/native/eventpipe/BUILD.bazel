load("@rules_cc//cc:defs.bzl", "cc_library")

# EventPipe and DiagnosticServer for linux-x64
#
# These are INTERFACE libraries in CMake — the source files are not compiled
# here but by the consuming runtime (CoreCLR, Mono, or NativeAOT), each of
# which provides its own ep-rt.h / ds-rt.h implementation.
#
# In Bazel, we expose:
#   - filegroups for source files (consumers add to their own srcs)
#   - a cc_library for headers and include paths

# Sources for dn-eventpipe (EventPipe core)
filegroup(
    name = "dn-eventpipe-srcs",
    srcs = [
        "ep.c",
        "ep-block.c",
        "ep-buffer.c",
        "ep-buffer-manager.c",
        "ep-config.c",
        "ep-event.c",
        "ep-event-instance.c",
        "ep-event-payload.c",
        "ep-event-source.c",
        "ep-file.c",
        "ep-json-file.c",
        "ep-metadata-generator.c",
        "ep-provider.c",
        "ep-sample-profiler.c",
        "ep-session.c",
        "ep-session-provider.c",
        "ep-stack-contents.c",
        "ep-stream.c",
        "ep-string.c",
        "ep-thread.c",
    ],
    visibility = ["//src:__subpackages__"],
)

# Sources for dn-diagnosticserver (DiagnosticServer core)
filegroup(
    name = "dn-diagnosticserver-srcs",
    srcs = [
        "ds-dump-protocol.c",
        "ds-eventpipe-protocol.c",
        "ds-ipc.c",
        "ds-portable-rid.c",
        "ds-process-protocol.c",
        "ds-profiler-protocol.c",
        "ds-protocol.c",
        "ds-server.c",
    ],
    visibility = ["//src:__subpackages__"],
)

# Sources for dn-diagnosticserver-pal (platform abstraction)
# On linux-x64 (not mobile, not Windows, not WebSocket): uses TCP socket PAL
filegroup(
    name = "dn-diagnosticserver-pal-srcs",
    srcs = [
        "ds-ipc-pal-socket.c",
    ],
    visibility = ["//src:__subpackages__"],
)

# Headers for eventpipe and diagnosticserver.
# Consumers depend on this to get include paths and the generated config header.
cc_library(
    name = "eventpipe-headers",
    hdrs = [
        "ds-dump-protocol.h",
        "ds-eventpipe-protocol.h",
        "ds-getter-setter.h",
        "ds-ipc-pal-namedpipe.h",
        "ds-ipc-pal-socket.h",
        "ds-ipc-pal-types.h",
        "ds-ipc-pal-websocket.h",
        "ds-ipc-pal.h",
        "ds-ipc.h",
        "ds-process-protocol.h",
        "ds-profiler-protocol.h",
        "ds-protocol.h",
        "ds-rt-config.h",
        "ds-rt-types.h",
        "ds-rt.h",
        "ds-server.h",
        "ds-types.h",
        "ep-block.h",
        "ep-buffer-manager.h",
        "ep-buffer.h",
        "ep-config-internals.h",
        "ep-config.h",
        "ep-event-instance.h",
        "ep-event-payload.h",
        "ep-event-source.h",
        "ep-event.h",
        "ep-file.h",
        "ep-getter-setter.h",
        "ep-ipc-pal-types-forward.h",
        "ep-ipc-pal-types.h",
        "ep-ipc-stream.h",
        "ep-json-file.h",
        "ep-metadata-generator.h",
        "ep-provider-internals.h",
        "ep-provider.h",
        "ep-rt-config.h",
        "ep-rt-types.h",
        "ep-rt.h",
        "ep-sample-profiler.h",
        "ep-session-provider.h",
        "ep-session.h",
        "ep-stack-contents.h",
        "ep-stream.h",
        "ep-string.h",
        "ep-thread.h",
        "ep-types-forward.h",
        "ep-types.h",
        "ep.h",
    ] + select({
        "@platforms//os:macos": ["bazel/darwin-arm64/ep-shared-config.h"],
        "//conditions:default": ["bazel/linux-glibc-x64/ep-shared-config.h"],
    }),
    includes = ["."] + select({
        "@platforms//os:macos": ["bazel/darwin-arm64"],
        "//conditions:default": ["bazel/linux-glibc-x64"],
    }),
    visibility = ["//src:__subpackages__"],
    deps = [
        "//src/native/containers:dn-containers",
        "//src/native/minipal",
    ],
)
