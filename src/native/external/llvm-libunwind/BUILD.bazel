# LLVM libunwind — sources compiled into NativeAOT runtime.
# The NativeAOT runtime compiles these files directly (not as a shared library).

load("@rules_cc//cc:defs.bzl", "cc_library")

exports_files(
    [
        "src/Unwind-EHABI.cpp",
        "src/libunwind.cpp",
        "src/UnwindRegistersRestore.S",
        "src/UnwindRegistersSave.S",
    ],
    visibility = ["//src/coreclr:__subpackages__"],
)

# Headers needed when compiling llvm-libunwind sources into NativeAOT.
cc_library(
    name = "llvm_libunwind_headers",
    hdrs = [
        "include/__libunwind_config.h",
        "include/libunwind.h",
        "include/mach-o/compact_unwind_encoding.h",
        "include/unwind.h",
        "include/unwind_arm_ehabi.h",
        "include/unwind_itanium.h",
        "src/AddressSpace.hpp",
        "src/CompactUnwinder.hpp",
        "src/DwarfInstructions.hpp",
        "src/DwarfParser.hpp",
        "src/EHHeaderParser.hpp",
        "src/FrameHeaderCache.hpp",
        "src/RWMutex.hpp",
        "src/Registers.hpp",
        "src/Unwind-EHABI.h",
        "src/UnwindCursor.hpp",
        "src/assembly.h",
        "src/cet_unwind.h",
        "src/config.h",
        "src/dwarf2.h",
        "src/libunwind_ext.h",
    ],
    includes = ["include"],
    visibility = ["//src/coreclr:__subpackages__"],
)
