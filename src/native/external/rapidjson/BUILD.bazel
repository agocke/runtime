# Header-only JSON library used by corehost.

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "rapidjson",
    hdrs = [
        "allocators.h",
        "document.h",
        "encodedstream.h",
        "encodings.h",
        "error/en.h",
        "error/error.h",
        "fwd.h",
        "internal/biginteger.h",
        "internal/clzll.h",
        "internal/diyfp.h",
        "internal/dtoa.h",
        "internal/ieee754.h",
        "internal/itoa.h",
        "internal/meta.h",
        "internal/pow10.h",
        "internal/stack.h",
        "internal/strfunc.h",
        "internal/strtod.h",
        "internal/swap.h",
        "istreamwrapper.h",
        "memorystream.h",
        "rapidjson.h",
        "reader.h",
        "stream.h",
        "stringbuffer.h",
        "writer.h",
    ],
    strip_include_prefix = ".",
    include_prefix = "rapidjson",
    visibility = ["//src/native:__subpackages__"],
)
