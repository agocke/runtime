load("//src/libraries:defs.bzl", "netcoreapp_impl_assembly")

# For net10.0, this library is essentially a set of type forwarders plus
# a thin X509CertificateKeyAccessors extension class.  The heavy ASN.1 /
# PQC / X509Loader code is only compiled for older TFMs.
netcoreapp_impl_assembly(
    name = "impl_Microsoft.Bcl.Cryptography",
    multitarget = True,
    srcs = [
        "src/Microsoft.Bcl.Cryptography.Forwards.cs",
        "src/System/Security/Cryptography/X509Certificates/X509CertificateKeyAccessors.cs",
        "//src/libraries/Common:src/System/Experimentals.cs",
    ],
    deps = [
        "//src/libraries:ref_System.Runtime",
        "//src/libraries/System.Security.Cryptography:ref_System.Security.Cryptography",
    ],
    nowarn = ["SYSLIB5006"],
    exclude_sr = True,
)
