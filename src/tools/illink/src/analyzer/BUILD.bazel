load("@rules_dotnet//dotnet:defs.bzl", "csharp_binary")

csharp_binary(
    name = "illinkanalyzer",
    srcs = [
        "ConsoleDependencyGraph.cs",
        "LinkerAnalyzerCore/DependencyGraph.cs",
        "LinkerAnalyzerCore/SpaceAnalyzer.cs",
        "Main.cs",
    ] + [
        "//src/tools/illink/external:Mono.Options/Options.cs",
    ],
    out = "illinkanalyzer",
    deps = [
        "@paket.main//microsoft.dotnet.cecil",
    ],
    nullable = "disable",
    target_frameworks = ["net10.0"],
    nowarn = ["CS1701", "CS8500", "CS8969"],
    visibility = ["//visibility:public"],
)
