# AOT JIT interface — shared library used by ILC/crossgen2 for AOT compilation.
# Matches CMake: src/coreclr/tools/aot/jitinterface/CMakeLists.txt

load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "libjitinterface_x64.so",
    srcs = [
        "corinfoexception.cpp",
        "corinfoexception.h",
        "dllexport.h",
        "jithost.cpp",
        "jitinterface.cpp",
        "jitinterface_generated.h",
        "jitwrapper.cpp",
    ],
    linkshared = True,
    linkstatic = True,
    copts = [
        "-Isrc/coreclr/tools/aot/jitinterface",
        "-fvisibility=default",
    ],
    deps = [
        "//src/coreclr/inc:coreclr_inc_headers_only",
        "//src/native/minipal",
    ],
)
