# CoreCLR debug headers and libraries.
# Currently provides header-only targets; compiled debug libraries will be added later.

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//src/coreclr:__subpackages__"])

cc_library(
    name = "debug_inc",
    hdrs = glob([
        "inc/*.h",
        "inc/*.inl",
        "inc/amd64/*.h",
        "inc/dump/*.h",
        # Headers from debug subdirectories used by other coreclr components
        "ee/*.h",
        "ee/*.inl",
        "ee/amd64/*.h",
        "daccess/*.h",
        "dbgutil/*.h",
        "di/*.hpp",
        "di/*.inl",
    ]),
)

# --- cDAC data descriptor shared infrastructure ---
# Used by GC (and later VM) data descriptor stubs.

# Header-only target for contract-descriptor.h
cc_library(
    name = "datadescriptor_shared_inc",
    hdrs = ["datadescriptor-shared/inc/contract-descriptor.h"],
    strip_include_prefix = "datadescriptor-shared/inc",
)

# Stub contract descriptor source (exported as a filegroup so multiple
# cc_library targets can each compile their own copy with different defines).
exports_files(
    ["datadescriptor-shared/contractdescriptorstub.c"],
)
