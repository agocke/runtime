# CoreCLR common headers — the central inc/ directory.
# Nearly all coreclr components depend on this.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//src/coreclr:coreclr_defs.bzl", "CORECLR_COPTS", "CORECLR_DEFINES")

package(default_visibility = ["//src/coreclr:__subpackages__"])

cc_library(
    name = "coreclr_inc",
    hdrs = glob(
        [
            "*.h",
            "*.inl",
            "*.def",
            "clr/**/*.h",
            "llvm/*.h",
            "llvm/*.def",
        ],
        allow_empty = True,
    ) + ["mpl/type_list"],
    textual_hdrs = glob(["*.cpp"]),
    copts = CORECLR_COPTS,
    defines = CORECLR_DEFINES,
    includes = ["."],
    deps = [
        "//src/coreclr/binder:binder_headers",
        "//src/coreclr/debug:debug_inc",
        "//src/coreclr/dlls:dlls_headers",
        "//src/coreclr/gc:gc_headers",
        "//src/coreclr/gcdump:gcdump_headers",
        "//src/coreclr/hosts:hosts_inc",
        "//src/coreclr/interpreter:interpreter_headers",
        "//src/coreclr/jit:jit_headers",
        "//src/coreclr/md:md_inc",
        "//src/coreclr/minipal:coreclrminipal_headers",
        "//src/coreclr/pal:pal_headers",
        "//src/coreclr/vm:vm_headers",
        "//src/coreclr/vm/eventing:eventing_headers",
        "//src/native:native_inc",
        "//src/native/minipal",
        "//eng/native:version_headers",
    ],
)

# Lightweight header-only target for components that only need the inc/
# header files without the full transitive dependency graph (e.g., PAL).
cc_library(
    name = "coreclr_inc_headers_only",
    hdrs = glob(
        [
            "*.h",
            "*.inl",
            "*.def",
            "clr/**/*.h",
            "llvm/*.h",
            "llvm/*.def",
        ],
        allow_empty = True,
    ) + ["mpl/type_list"],
    textual_hdrs = glob(["*.cpp"]),
)
