        "@platforms//os:macos": ["src/bazel/darwin-arm64/config.h"],
        "//conditions:default": ["src/bazel/linux-glibc-x64/config.h"],
    }) + [
        "src/include/pal/cgroup.h",
        "src/include/pal/context.h",
        "src/include/pal/corunix.hpp",
        "src/include/pal/cruntime.h",
        "src/include/pal/dbgmsg.h",
