        "src/include/pal/environ.h",
        "src/include/pal/event.hpp",
        "src/include/pal/fakepoll.h",
        "src/include/pal/file.h",
        "src/include/pal/file.hpp",
        "src/include/pal/filetime.h",
        "src/include/pal/handleapi.hpp",
        "src/include/pal/handlemgr.hpp",
        "src/include/pal/init.h",
        "src/include/pal/list.h",
        "src/include/pal/map.h",
        "src/include/pal/map.hpp",
        "src/include/pal/module.h",
        "src/include/pal/mutex.hpp",
        "src/include/pal/palinternal.h",
        "src/include/pal/perftrace.h",
        "src/include/pal/process.h",
        "src/include/pal/procobj.hpp",
        "src/include/pal/seh.hpp",
        "src/include/pal/semaphore.hpp",
        "src/include/pal/sharedmemory.h",
        "src/include/pal/signal.hpp",
        "src/include/pal/stackstring.hpp",
        "src/include/pal/synchcache.hpp",
        "src/include/pal/synchobjects.hpp",
        "src/include/pal/thread.hpp",
        "src/include/pal/threadinfo.hpp",
        "src/include/pal/threadsusp.hpp",
        "src/include/pal/utils.h",
        "src/include/pal/virtual.h",
    ],
    copts = CORECLR_COPTS + CLR_CONFIG_COPTS,
    includes = [
        "src",
        "src/include",
        "src/safecrt",
        "inc",
        "inc/rt",
    ],
    local_defines = CLR_CONFIG_DEFINES,
    defines = CORECLR_DAC_DEFINES + select({
        # On macOS, use bundled libunwind for remote unwinding (UNW_REMOTE_ONLY only)
        "@platforms//os:macos": [
