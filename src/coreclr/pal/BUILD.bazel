# On macOS, uses bundled GNU libunwind for remote unwinding (HAVE_UNW_GET_ACCESSORS).
cc_library(
    name = "coreclrpal_dac",
    srcs = ["src/exception/remote-unwind.cpp"] + select({
        "@platforms//os:macos": ["src/exception/compact_unwind_encoding.h"],
