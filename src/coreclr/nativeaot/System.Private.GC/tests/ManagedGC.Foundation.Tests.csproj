<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NetCoreAppToolCurrent)</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <AddAdditionalExplicitAssemblyReferences>true</AddAdditionalExplicitAssemblyReferences>
    <AssemblyName>ManagedGC.Foundation.Tests</AssemblyName>
    <SignAssembly>false</SignAssembly>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The layout tests walk the translated types by name, and this assembly is a host-only
         test that is never trimmed. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Kept in step with src/System.Private.GC.csproj: the virtual memory port picks the
         <sys/mman.h> values of the platform it is compiled for. -->
    <DefineConstants Condition="'$(TargetsOSX)' == 'true' or '$(TargetsMacCatalyst)' == 'true' or '$(TargetsiOS)' == 'true' or '$(TargetstvOS)' == 'true'">TARGET_APPLE;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(TargetsFreeBSD)' == 'true'">TARGET_FREEBSD;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(TargetsOpenBSD)' == 'true'">TARGET_OPENBSD;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(TargetsLinuxMusl)' == 'true'">TARGET_LINUX_MUSL;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(TargetsAndroid)' == 'true' or '$(TargetsLinuxBionic)' == 'true'">TARGET_BIONIC;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.XUnitExtensions" Version="$(MicrosoftDotNetXUnitExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="GCEnvironmentTests.cs" />
    <Compile Include="GCMemoryLimitsTests.cs" />
    <Compile Include="GCVirtualMemoryTests.cs" />
    <Compile Include="GCWriteWatchTests.cs" />
    <Compile Include="GCEventTests.cs" />
    <Compile Include="GCCriticalSectionTests.cs" />
    <Compile Include="GCSleepYieldTests.cs" />
    <Compile Include="GCTimerTests.cs" />
    <Compile Include="GCProcessorTests.cs" />
    <Compile Include="GCFoundationTests.cs" />
    <Compile Include="GCInterfaceLayoutTests.cs" />
    <!-- The environment layer. Its OS calls are [RuntimeImport] declarations, which resolve
         only inside a NativeAOT image; the tests here drive the parts that are pure
         computation and check the layouts of the types that cross into the native gcenv. -->
    <Compile Include="../src/System/Runtime/RuntimeImportAttribute.cs" Link="System/Runtime/RuntimeImportAttribute.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/AffinitySet.cs" Link="Environment/AffinitySet.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEnv.Base.cs" Link="Environment/GCEnv.Base.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEnv.Volatile.cs" Link="Environment/GCEnv.Volatile.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEnvStructs.cs" Link="Environment/GCEnvStructs.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEnvSync.cs" Link="Environment/GCEnvSync.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEvent.cs" Link="Environment/GCEvent.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.cs" Link="Environment/GCToOSInterface.cs" />
    <!-- The virtual memory and write watch ports are real code rather than forwarders, so they
         are compiled and run here. Only the libc/Win32 declarations underneath them are
         substituted: the shipping ones are [RuntimeImport]s that resolve only in a NativeAOT
         image. -->
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.VirtualMemory.Unix.cs" Link="Environment/GCToOSInterface.VirtualMemory.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.VirtualMemory.Windows.cs" Link="Environment/GCToOSInterface.VirtualMemory.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.WriteWatch.Unix.cs" Link="Environment/GCToOSInterface.WriteWatch.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.WriteWatch.Windows.cs" Link="Environment/GCToOSInterface.WriteWatch.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.Thread.Unix.cs" Link="Environment/GCToOSInterface.Thread.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.Thread.Windows.cs" Link="Environment/GCToOSInterface.Thread.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.MemoryLimits.Unix.cs" Link="Environment/GCToOSInterface.MemoryLimits.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.MemoryLimits.Windows.cs" Link="Environment/GCToOSInterface.MemoryLimits.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.Timers.Unix.cs" Link="Environment/GCToOSInterface.Timers.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.Timers.Windows.cs" Link="Environment/GCToOSInterface.Timers.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.Processors.Unix.cs" Link="Environment/GCToOSInterface.Processors.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCToOSInterface.Processors.Windows.cs" Link="Environment/GCToOSInterface.Processors.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="GCToOSInterface.Imports.Unix.TestHost.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="GCToOSInterface.Imports.Windows.TestHost.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <!-- The event and lock ports are real code rather than forwarders too, so the shipping
         bodies run here over substituted pthread / Win32 declarations. The types they name are
         the shipping ones: only the entry points are substituted. -->
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/SyncTypes.Unix.cs" Link="Environment/SyncTypes.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/SyncTypes.Windows.cs" Link="Environment/SyncTypes.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEvent.Unix.cs" Link="Environment/GCEvent.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEvent.Windows.cs" Link="Environment/GCEvent.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEnvSync.Unix.cs" Link="Environment/GCEnvSync.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/GCEnvSync.Windows.cs" Link="Environment/GCEnvSync.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="SyncImports.Unix.TestHost.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="SyncImports.Windows.TestHost.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Environment/Interlocked.cs" Link="Environment/Interlocked.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/GCEventEnums.cs" Link="GCEventEnums.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/GCEventStatus.cs" Link="GCEventStatus.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/IntroSort.cs" Link="IntroSort.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Interface/GCInterfaceDac.cs" Link="Interface/GCInterfaceDac.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Interface/GCInterfaceEnums.cs" Link="Interface/GCInterfaceEnums.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Interface/GCInterfaceStructs.cs" Link="Interface/GCInterfaceStructs.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Interface/GCInterfaceVtables.cs" Link="Interface/GCInterfaceVtables.cs" />
    <!-- GCConfig is here because the cache sizing port of GCToOSInterface reads one config
         value out of it. Its backing fields are only ever written by GCConfig.Initialize,
         which the tests do not run, so every value the tests see is the documented default. -->
    <Compile Include="../src/Internal/Runtime/GarbageCollection/Interface/GCToEEInterface.cs" Link="Interface/GCToEEInterface.cs" />
    <Compile Include="../src/Internal/Runtime/GarbageCollection/GCConfig.cs" Link="GCConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The layout table the tests check the translated types against. It is embedded rather
         than read from the source tree so that the tests do not depend on their own location. -->
    <EmbeddedResource Include="../GCInterfaceOffsets.h" LogicalName="GCInterfaceOffsets.h" />
  </ItemGroup>
</Project>
