<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <!-- The GC runs with the world suspended and must never allocate; nothing here may
         depend on the ref assembly surface of System.Private.CoreLib. -->
    <CompileUsingReferenceAssemblies>false</CompileUsingReferenceAssemblies>
    <!-- Lives in aotsdk so that ILC picks it up through PrivateSdkAssemblies, like the other
         System.Private.* assemblies. Merely referencing it costs nothing: none of its code is
         reachable unless IlcManagedGC roots its runtime exports, so default (C++ GC) builds are
         unaffected. -->
    <DocumentationFile>$(OutputPath)$(MSBuildProjectName).xml</DocumentationFile>
    <NoWarn Condition="'$(ManagedGCServerBuild)' == 'true'">$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The Unix virtual memory port selects the <sys/mman.h> and <sys/resource.h> values of the
         platform it is built for, exactly as gc/unix/gcenv.unix.cpp does through config.gc.h.
         The values it picks are asserted against the real headers by
         nativeaot/Runtime/gcenv.managed.cpp. -->
    <DefineConstants Condition="'$(TargetsOSX)' == 'true' or '$(TargetsMacCatalyst)' == 'true' or '$(TargetsiOS)' == 'true' or '$(TargetstvOS)' == 'true'">TARGET_APPLE;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(TargetsFreeBSD)' == 'true'">TARGET_FREEBSD;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(TargetsOpenBSD)' == 'true'">TARGET_OPENBSD;$(DefineConstants)</DefineConstants>
    <!-- The Unix event port selects the <time.h> struct timespec of the platform it is built
         for; musl is the one C library whose time_t is wider than a pointer. The native build
         defines the same symbol, and gcenv.managed.cpp asserts the layout the C# selects. -->
    <DefineConstants Condition="'$(TargetsLinuxMusl)' == 'true'">TARGET_LINUX_MUSL;$(DefineConstants)</DefineConstants>
    <!-- The sleep port reaches errno through the accessor the C library exports, and that name
         is per C library rather than per operating system: bionic and OpenBSD call it __errno
         where glibc and musl call it __errno_location. The native check in gcenv.managed.cpp is
         keyed on the corresponding native platform defines. -->
    <DefineConstants Condition="'$(TargetsAndroid)' == 'true' or '$(TargetsLinuxBionic)' == 'true'">TARGET_BIONIC;$(DefineConstants)</DefineConstants>
    <!-- The NUMA arms of the processor and virtual memory ports are keyed on the operating
         system rather than on the C library: the C++ compiles them under
         `TARGET_LINUX && !TARGET_ANDROID`, which includes the linux-bionic RID because the
         native build labels it Linux. gcenv.managed.cpp checks the two selections against each
         other. -->
    <DefineConstants Condition="'$(TargetsAndroid)' == 'true'">TARGET_ANDROID;$(DefineConstants)</DefineConstants>
    <!-- gcpriv.h enables BACKGROUND_GC on every non-WASM full runtime. The server companion
         project imports this project with ManagedGCServerBuild=true, selecting the same
         SERVER_GC -> MULTIPLE_HEAPS -> DYNAMIC_HEAP_COUNT chain as gcimpl.h/gcpriv.h. -->
    <DefineConstants Condition="'$(Platform)' != 'wasm'">BACKGROUND_GC;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(ManagedGCServerBuild)' == 'true'">SERVER_GC;MULTIPLE_HEAPS;DYNAMIC_HEAP_COUNT;$(DefineConstants)</DefineConstants>
    <!-- NativeAOT's runtime CMake enables software write watch and manually maintained card
         bundles together on these architectures. The assembly write barrier maintains the
         bundle table, so GC-internal card writes must compile the matching set_card path. -->
    <DefineConstants Condition="'$(Platform)' == 'x64' or '$(Platform)' == 'arm64' or '$(Platform)' == 'loongarch64' or '$(Platform)' == 'riscv64'">FEATURE_USE_SOFTWARE_WRITE_WATCH_FOR_GC_HEAP;FEATURE_MANUALLY_MANAGED_CARD_BUNDLES;$(DefineConstants)</DefineConstants>
    <!-- USE_REGIONS is the collector's region layout. gcpriv.h defines it as
         HOST_64BIT && !BUILD_AS_STANDALONE && !__sun && (!HOST_APPLE || HOST_OSX). This integrated
         port is never BUILD_AS_STANDALONE and never targets illumos/Solaris, so it reduces to
         64-bit AND not an Apple mobile platform (iOS/tvOS/MacCatalyst); OSX and every non-Apple
         64-bit target use regions. The generated GCInterfaceOffsets.cs computes the same symbol
         from the same primitives so the pinned layout table matches. -->
    <DefineConstants Condition="('$(Platform)' == 'x64' or '$(Platform)' == 'arm64' or '$(Platform)' == 'loongarch64' or '$(Platform)' == 'riscv64') and '$(TargetsMacCatalyst)' != 'true' and '$(TargetsiOS)' != 'true' and '$(TargetstvOS)' != 'true'">USE_REGIONS;$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The generated GCInterfaceOffsets.cs is only available when the native runtime is built
         alongside the managed one, which is the case for all in-tree builds. -->
    <InPlaceRuntime>true</InPlaceRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InPlaceRuntime)' == 'true'">
    <IntermediatesDir>$(ArtifactsObjDir)\coreclr\$(TargetOS).$(TargetArchitecture).$(CoreCLRConfiguration)</IntermediatesDir>
    <IntermediatesDir Condition="'$(Ninja)' == 'false' and $([MSBuild]::IsOsPlatform('Windows'))">$(IntermediatesDir)\ide</IntermediatesDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\System.Private.CoreLib\src\System.Private.CoreLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Internal\Runtime\GarbageCollection\BackgroundGC.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCAllocation.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Collect.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Diagnostics.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCCommon.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCConfig.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCDesc.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\DynamicTuning.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\FullGCNotification.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCBridge.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCEventEnums.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCEvents.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCEventSerializer.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCEventStatus.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCHeapCriticalRegion.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCHeapMemory.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCMemory.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCPriv.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCRecord.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCRegionsSegments.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCScan.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\GCWriteBarrier.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\HandleTableConstants.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\HandleTable.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\HandleTableCache.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\HandleTableCore.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\HandleTableScan.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\HandleTableStructs.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\SoftwareWriteWatch.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\SweepPhase.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\VxSort.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\AffinitySet.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEnv.Base.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEnv.MemoryBarrierProcessWide.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEnv.Volatile.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEnvStructs.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEnvSync.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEvent.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.cs" />
    <!-- One virtual memory and write watch implementation per gcenv platform file, as the
         native build picks between gc/unix/gcenv.unix.cpp and gc/windows/gcenv.windows.cpp. The
         imports they call are in a file of their own so that the tests can substitute callable
         declarations. -->
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Imports.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Imports.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.VirtualMemory.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.VirtualMemory.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.WriteWatch.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.WriteWatch.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <!-- Sleep and yield, from the "thread and process" section of the same two gcenv files. -->
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Thread.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Thread.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.MemoryLimits.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.MemoryLimits.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <!-- The "time" section of the same two gcenv files. -->
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Timers.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Timers.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <!-- The processor counts and the thread and process identity of the same two gcenv files. -->
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Processors.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCToOSInterface.Processors.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <!-- The event and lock implementations, likewise one per gcenv platform file:
         gc/unix/events.cpp and the GCEvent half of gc/windows/gcenv.windows.cpp, plus the two
         halves of src/native/minipal/mutex.c that CLRCriticalSection forwards to. The pthread
         and Win32 types they name are shared with the tests; the declarations of the entry
         points they call are substituted there. -->
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\SyncTypes.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\SyncTypes.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\SyncImports.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\SyncImports.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEvent.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEvent.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEnvSync.Unix.cs" Condition="'$(TargetsWindows)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\GCEnvSync.Windows.cs" Condition="'$(TargetsWindows)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\Environment\Interlocked.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\IntroSort.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedGCEntryPoints.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedGCHandleManager.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedGCHeap.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedGCRegionBootstrap.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedServerGC.cs" Condition="'$(ManagedGCServerBuild)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedServerGCCondemn.cs" Condition="'$(ManagedGCServerBuild)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedServerGCMark.cs" Condition="'$(ManagedGCServerBuild)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\ManagedServerGCMarkPhase.cs" Condition="'$(ManagedGCServerBuild)' == 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\MarkPhase.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\NoGC.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\ObjectHandle.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\PlanPhase.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="Internal\Runtime\GarbageCollection\RelocateCompact.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="System\Runtime\RuntimeExportAttribute.cs" />
    <Compile Include="System\Runtime\RuntimeImportAttribute.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceDac.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceEnums.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceLayout.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceStructs.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCInterfaceVtables.cs" />
    <Compile Include="Internal\Runtime\GarbageCollection\Interface\GCToEEInterface.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(InPlaceRuntime)' == 'true'">
    <Compile Include="$(IntermediatesDir)\nativeaot\Runtime\Full\GCInterfaceOffsets.cs" Condition="'$(ManagedGCServerBuild)' != 'true'" />
    <Compile Include="$(IntermediatesDir)\nativeaot\Runtime\Full\GCInterfaceOffsets.Server.cs" Condition="'$(ManagedGCServerBuild)' == 'true'" />
  </ItemGroup>
</Project>
