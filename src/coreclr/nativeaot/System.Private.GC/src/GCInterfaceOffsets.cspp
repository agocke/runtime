#define PLAT_GC_OFFSET(offset, cls, member) internal const int OFFSETOF__##cls##__##member = 0x##offset;
#define PLAT_GC_SIZEOF(offset, cls) internal const int SIZEOF__##cls = 0x##offset;
#define PLAT_GC_ALIGNOF(align, cls) internal const int ALIGNOF__##cls = 0x##align;
#define PLAT_GC_CONST(constant, expr) internal const int expr = unchecked((int)0x##constant);
#define PLAT_GC_VALUE(constant, name, expr) internal const int name = unchecked((int)0x##constant);

namespace Internal.Runtime.GarbageCollection
{
    internal static class GCInterfaceOffsets
    {
// GCInterfaceOffsets.h selects the generation schema with the same gcpriv.h feature switches the
// real GC uses. gcpriv.h defines them, but this file does not include it, so reproduce the three the
// table needs from the same primitives the compile definitions carry. The verify side in
// GCInterfaceOffsetsVerify.cpp gets the real definitions through gcinternal.h instead. These
// #defines are consumed by the preprocessor and are placed inside the class so any surviving
// comment lands in the class body rather than the generated file's license header.
#if !defined(TARGET_WASM)
#define BACKGROUND_GC
#endif
#if defined(HOST_64BIT) && !defined(BUILD_AS_STANDALONE) && !defined(__sun) && (!defined(HOST_APPLE) || defined(HOST_OSX))
#define USE_REGIONS
#endif
#if defined(HOST_64BIT) && !defined(TARGET_WASM)
#define DOUBLY_LINKED_FL
#endif
#if defined(SERVER_GC)
#define MULTIPLE_HEAPS
#if defined(USE_REGIONS)
#define DYNAMIC_HEAP_COUNT
#endif
#endif
#include "../GCInterfaceOffsets.h"
    }
}
