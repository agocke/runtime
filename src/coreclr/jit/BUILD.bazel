# CoreCLR JIT compiler — headers and clrjit_static OBJECT library.
# Matches CMake: src/coreclr/jit/CMakeLists.txt + jit/static/CMakeLists.txt

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//src/coreclr:coreclr_defs.bzl", "CORECLR_COPTS", "CORECLR_DEFINES")

package(default_visibility = ["//src/coreclr:__subpackages__"])

cc_library(
    name = "jit_headers",
    hdrs = glob(
        [
            "*.h",
            "*.hpp",
            "*.def",
            "jitstd/*.h",
        ],
        allow_empty = True,
    ),
)

# --- clrjit_static (JIT compiled as OBJECT lib for linking into coreclr) ---
