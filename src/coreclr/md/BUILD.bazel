# CoreCLR metadata headers and libraries.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//:cc_pch.bzl", "cc_pch")
load("//src/coreclr:coreclr_defs.bzl", "CLR_CONFIG_DEFINES", "CORECLR_COPTS", "CLR_CONFIG_COPTS", "CORECLR_DEFINES", "CORECLR_DAC_DEFINES")

package(default_visibility = ["//src/coreclr:__subpackages__"])

# Public metadata headers (inc/ directory + root headers + subdirectory headers).
cc_library(
    name = "md_inc",
    hdrs = glob([
        "inc/*.h",
        "inc/*.inc",
        "*.h",
        "*.inl",
        "heaps/*.h",
        "tables/*.h",
        "datasource/*.h",
        "compiler/*.h",
        "runtime/*.h",
        "enc/*.h",
    ]),
)

_MD_COPTS = CORECLR_COPTS + CLR_CONFIG_COPTS

_MD_INCLUDES = [
    "inc",
    ".",
]

# Directory-level defines from src/coreclr/md/CMakeLists.txt
# (non-DAC, non-DBI variant for the VM build)
_MD_DEFINES = CORECLR_DEFINES + [
    "FEATURE_METADATA_EMIT",
    "FEATURE_METADATA_EMIT_ALL",
    "FEATURE_METADATA_INTERNAL_APIS",
    "FEATURE_METADATA_IN_VM",
    "FEATURE_METADATA_VERIFY_LAYOUTS",
]

# DAC variant: FEATURE_METADATA_EMIT_IN_DEBUGGER replaces _IN_VM and _VERIFY_LAYOUTS;
# no FEATURE_METADATA_EMIT_ALL.
_MD_DAC_DEFINES = CORECLR_DAC_DEFINES + [
    "FEATURE_METADATA_EMIT",
    "FEATURE_METADATA_INTERNAL_APIS",
    "FEATURE_METADATA_EMIT_IN_DEBUGGER",
]

# DBI variant: like DAC but with DBI-specific data source defines;
# uses WKS profiling defines (not DAC).
_MD_DBI_DEFINES = CORECLR_DEFINES + [
    "FEATURE_METADATA_EMIT",
    "FEATURE_METADATA_INTERNAL_APIS",
    "FEATURE_METADATA_EMIT_IN_DEBUGGER",
    "FEATURE_METADATA_CUSTOM_DATA_SOURCE",
    "FEATURE_METADATA_DEBUGGEE_DATA_SOURCE",
    "FEATURE_METADATA_LOAD_TRUSTED_IMAGES",
    "FEATURE_METADATA_RELEASE_MEMORY_ON_REOPEN",
]

