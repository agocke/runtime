load("@rules_dotnet//dotnet:defs.bzl", "import_library")
load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//eng/bazel:runtime_layout.bzl", "runtime_layout")
load("//eng/bazel:version.bzl", "PRODUCT_VERSION")

exports_files([
    "artifacts/obj/coreclr/System.Private.CoreLib/linux.x64.Debug/System.Private.CoreLib.Strings.resources",
])

# ── Per-component build configuration flags ──────────────────────────
# These replace the legacy --define runtime_debug=1 mechanism with modern
# Bazel string_flag build settings.
#
# Set via command line:  --//:clr_config=release  --//:libs_config=release
# Or via .bazelrc:       --config=clr_release     --config=libs_release
#
# CoreCLR configuration: debug (default), checked, or release.
#   debug   = assertions + debug defines + no optimization
#   checked = assertions + debug defines + release optimization (-O2)
#   release = no assertions + NDEBUG + release optimization
string_flag(
    name = "clr_config",
    build_setting_default = "debug",
    visibility = ["//visibility:public"],
)

# Libraries configuration: debug (default) or release.
string_flag(
    name = "libs_config",
    build_setting_default = "debug",
    visibility = ["//visibility:public"],
)

# ── CoreCLR config_settings ──────────────────────────────────────────
config_setting(
    name = "clr_debug",
    flag_values = {"//:clr_config": "debug"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "clr_checked",
    flag_values = {"//:clr_config": "checked"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "clr_release",
    flag_values = {"//:clr_config": "release"},
    visibility = ["//visibility:public"],
)

# ── Libraries config_settings ────────────────────────────────────────
config_setting(
    name = "libs_debug",
    flag_values = {"//:libs_config": "debug"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "libs_release",
    flag_values = {"//:libs_config": "release"},
    visibility = ["//visibility:public"],
)

# Compiler detection: set --define compiler=clang in .bazelrc config:clang.
config_setting(
    name = "compiler_clang",
    define_values = {"compiler": "clang"},
    visibility = ["//visibility:public"],
)

# Debug mode detection: matches -c dbg (--compilation_mode=dbg).
config_setting(
    name = "debug_mode",
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

# Legacy runtime_debug config_setting — kept for backward compatibility.
# Prefer //:clr_debug or //:clr_checked for new code.
config_setting(
    name = "runtime_debug",
    flag_values = {"//:clr_config": "debug"},
    visibility = ["//visibility:public"],
)

# ── Assembled native runtime layout ──────────────────────────────────
runtime_layout(
