# Bazel configuration for dotnet/runtime native builds.
#
# Supported platforms: linux-x64, osx-arm64, win-x64.
# Platform-specific flags are applied automatically via
# --enable_platform_specific_config (build:linux, build:macos, build:windows).
#
# Per-component configuration (matching MSBuild's -rc / -lc flags):
#
#   CoreCLR (clr_config):   debug, checked (default), release
#   Libraries (libs_config): debug (default), release
#
# Use --config flags to select:
#   --config=clr_debug       Debug CLR
#   --config=clr_checked     Checked CLR (debug asserts + release optimization)
#   --config=clr_release     Release CLR
#   --config=libs_release    Release libraries
#   --config=release         Release everything (= clr_release + libs_release)
#
# Use --compilation_mode (-c) for optimization:
#   -c dbg       Debug (matches CMake Debug: -O0, debug symbols)
#   -c opt       Release (matches CMake Release: -O2, -DNDEBUG)
#   -c fastbuild Default (fast incremental builds)
#
# Examples:
#   bazel build //...                                          # debug everything
#   bazel build --config=release //...                         # release everything
#   bazel build --config=clr_checked --config=libs_release //... # checked CLR + release libs
#   bazel build -c opt --config=clr_checked //...              # checked CLR + debug libs + -O2

# =====================================================================
# Unix compiler flags (GCC/Clang)
# =====================================================================
# Compiler flags (language standards, warnings, codegen options) are defined
# in cc_defs.bzl as PLATFORM_COPTS / PLATFORM_CONLYOPTS / PLATFORM_CXXOPTS
# and applied via BUILD file attributes.  Subsystem-specific constants
# (CORECLR_COPTS, NATIVEAOT_COPTS, etc.) incorporate them automatically.
#
# Only flags that have no BUILD-file equivalent remain here:
#   - per_file_copt / host_per_file_copt (no attribute equivalent)
#   - config selection (--config=clang)
#   - toolchain env vars (--repo_env=CC/CXX)

# Default to Clang on Unix (matching CMake).
build:unix --config=clang

# Disable warnings for vendored code
build:unix --per_file_copt=src/native/external/.*@-w
build:unix --host_per_file_copt=src/native/external/.*@-w

# safecrt_input_s.cpp is the non-unicode scanf variant — _UNICODE must not be defined
build:unix --per_file_copt=.*safecrt_input_s.*@-U_UNICODE,-UUNICODE
build:unix --host_per_file_copt=.*safecrt_input_s.*@-U_UNICODE,-UUNICODE

# --- Clang compiler (config:clang) ---
# Matches CMake default: uses clang/clang++ with lld linker on Linux.
# On macOS, Apple Clang + default ld are used (no lld).
build:clang --repo_env=CC=clang
build:clang --repo_env=CXX=clang++
build:clang --define compiler=clang

# =====================================================================
# Linux-specific settings
# =====================================================================
build:linux --config=unix
# Linker hardening and lld (no-ops or harmful on macOS).
build:linux --linkopt=-Wl,--build-id=sha1
build:linux --linkopt=-fuse-ld=lld

# =====================================================================
# macOS-specific settings
# =====================================================================
build:macos --config=unix
# Deployment target — match CMake's eng/native/configureplatform.cmake
build:macos --macos_minimum_os=12.0

# =====================================================================
# Windows-specific settings (MSVC)
# =====================================================================
# Applied automatically via --enable_platform_specific_config.
# Compiler and linker flags live in cc_defs.bzl (PLATFORM_COPTS,
# PLATFORM_LINKOPTS) so targets opt in explicitly, matching the
# PLATFORM_DEFINES pattern.  Only per_file_copt overrides (which have
# no BUILD-file equivalent) belong here.

# Disable Bazel's default dynamic CRT selection (/MD, /MDd).  The
# project controls CRT flags explicitly via NATIVE_CONFIG_COPTS in
# native_defs.bzl, selecting /MT or /MTd based on clr_config to match
# CMake's configurecompiler.cmake.
build:windows --features=-dynamic_link_msvcrt

# Force /DEBUG:FULL for all link actions.  Bazel's MSVC toolchain
# defaults to /DEBUG:FASTLINK in fastbuild mode, which is no longer
# supported by current MSVC linkers.  The /ignore:4315 suppresses the
# warning that the linker falls back to /DEBUG:FULL anyway.
build:windows --linkopt=/DEBUG:FULL
build:windows --linkopt=/ignore:4315

# Disable warnings for vendored code
build:windows --per_file_copt=src/native/external/.*@/w
build:windows --host_per_file_copt=src/native/external/.*@/w

# safecrt_input_s.cpp is the non-unicode scanf variant — _UNICODE must not be defined
build:windows --per_file_copt=.*safecrt_input_s.*@/U_UNICODE,/UUNICODE
build:windows --host_per_file_copt=.*safecrt_input_s.*@/U_UNICODE,/UUNICODE

# Enable automatic platform config selection (applies build:linux on Linux,
# build:macos on macOS, build:windows on Windows).
build --enable_platform_specific_config

# =====================================================================
# Per-component configuration
# =====================================================================
#
# CoreCLR and libraries have independent debug/release configurations,
# matching MSBuild's -rc (runtime config) and -lc (libraries config).
#
# Debug/checked/release defines are set per-target in BUILD files via
# select() on //:clr_config and //:libs_config.  See CLR_CONFIG_DEFINES
# in src/coreclr/coreclr_defs.bzl and NATIVE_CONFIG_DEFINES in
# src/native/native_defs.bzl.  The --config flags below set the
# string_flag values that drive those select() expressions.

# --- CoreCLR default: checked ---
build --//:clr_config=checked

# --- Libraries default: debug ---
build --//:libs_config=debug

# =====================================================================
# --config=clr_debug: Debug CoreCLR
# =====================================================================
build:clr_debug --//:clr_config=debug

# =====================================================================
# --config=clr_checked: Checked CoreCLR (same as default)
# =====================================================================
build:clr_checked --//:clr_config=checked

# =====================================================================
# --config=clr_release: Release CoreCLR
# =====================================================================
build:clr_release --//:clr_config=release
build:clr_release -c opt

# =====================================================================
# --config=libs_release: Release libraries
# =====================================================================
build:libs_release --//:libs_config=release

# =====================================================================
# --config=release: Release everything (convenience)
# =====================================================================
build:release --config=clr_release
build:release --config=libs_release
# Note: -c opt is on clr_release, so it applies here too.
